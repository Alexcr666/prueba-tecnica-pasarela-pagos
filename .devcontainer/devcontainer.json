{
  "name": "Pasarela de pagos (Java 21 + Oracle + RabbitMQ)",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installMaven": "false",
      "installGradle": "false"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "containerEnv": {
    "WEBHOOK_SECRETS": "dev-secret"
  },
  "postCreateCommand": "./mvnw -q -DskipTests package && docker compose --profile completo up -d --build",
  "postAttachCommand": "./scripts/iniciar.sh",
  "forwardPorts": [
    8080,
    8090,
    15672
  ],
  "portsAttributes": {
    "8080": {
      "label": "API del servicio"
    },
    "8090": {
      "label": "Consola de la prueba",
      "onAutoForward": "openBrowser"
    },
    "15672": {
      "label": "RabbitMQ (guest/guest)"
    },
    "1521": {
      "onAutoForward": "ignore"
    },
    "5672": {
      "onAutoForward": "ignore"
    },
    "8089": {
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "workbench.startupEditor": "none"
      }
    },
    "codespaces": {
      "openFiles": [
        "docs/PROBAR-ONLINE.md"
      ]
    }
  }
}